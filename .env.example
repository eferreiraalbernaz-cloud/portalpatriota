# Público: pode ser usado no navegador. Use os valores exibidos no painel do Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ou a chave publicável moderna do Supabase; se informada, tem precedência sobre ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privado: somente no servidor. Nunca use o prefixo NEXT_PUBLIC nestas variáveis.
SUPABASE_SERVICE_ROLE_KEY=
# A chave secreta moderna pode substituir SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Identificador técnico da conta usada pelo login somente com senha. Nunca envia e-mails.
ADMIN_LOGIN_EMAIL=painel@portalpatriotabr.invalid
BOOTSTRAP_ADMIN_EMAIL=admin@seudominio.com.br
BOOTSTRAP_SECRET=gere-um-segredo-longo-e-aleatorio
CRON_SECRET=gere-outro-segredo-longo-e-aleatorio

# Chave privada de criptografia AES-256-GCM, usada para credenciais cadastradas no painel e tokens Meta.
# Gere uma vez com: openssl rand -base64 32. Mantenha-a estável em todos os deploys.
APP_SECRETS_ENCRYPTION_KEY=
# Versão da API Meta. O App ID/App Secret são configurados uma vez no painel administrativo.
META_GRAPH_API_VERSION=v26.0

# Opcional: analytics externo e contato/redes do portal.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/portalpatriota_br/
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
