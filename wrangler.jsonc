  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://portalpatriotabr.pages.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://dikhcnfoxzchsjgleoww.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_RJk3uH4FjtN-UoWPGy_MoQ_mCxD_3Dv",
    "META_GRAPH_API_VERSION": "v26.0"
  }
}
